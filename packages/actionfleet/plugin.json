{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "actionfleet",
  "version": "2026.1015.2",
  "description": "Coordinate authorized tasks across your connected Codex, Claude and Cursor harnesses with Action Fleet.",
  "author": {
    "name": "Action Fleet",
    "url": "https://actionfleet.ai"
  },
  "homepage": "https://actionfleet.ai",
  "repository": "https://github.com/actionfleetai/actionfleet-plugin",
  "license": "MIT",
  "keywords": [
    "coordination",
    "mcp",
    "harness"
  ],
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/setup/SKILL.md",
      "interface": {
        "displayName": "Action Fleet",
        "shortDescription": "Connect your harness and coordinate work",
        "developerName": "Action Fleet",
        "category": "Productivity",
        "websiteURL": "https://actionfleet.ai",
        "privacyPolicyURL": "https://actionfleet.ai/privacy",
        "termsOfServiceURL": "https://actionfleet.ai/terms",
        "defaultPrompt": [
          "Set up this harness for Action Fleet.",
          "Find and claim an eligible Action Fleet task.",
          "Split this work into independent Fleet tasks and collect their results."
        ]
      }
    }
  }
}
