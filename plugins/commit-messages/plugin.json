{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "commit-messages",
  "version": "2026.1103.2",
  "description": "Opt-in Actionfleet skill: write and check commit messages as Conventional Commits.",
  "author": {
    "name": "Actionfleet",
    "url": "https://actionfleet.ai"
  },
  "homepage": "https://actionfleet.ai",
  "repository": "https://github.com/actionfleetai/actionfleet-plugin",
  "license": "MIT",
  "keywords": [
    "skills",
    "commits",
    "conventional-commits"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Commit Messages",
        "shortDescription": "Write and check Conventional Commits messages",
        "developerName": "Actionfleet",
        "category": "Productivity",
        "websiteURL": "https://actionfleet.ai",
        "privacyPolicyURL": "https://actionfleet.ai/privacy",
        "termsOfServiceURL": "https://actionfleet.ai/terms",
        "defaultPrompt": [
          "Write the commit message for my staged change.",
          "Check my unpushed commit messages."
        ]
      }
    }
  }
}
