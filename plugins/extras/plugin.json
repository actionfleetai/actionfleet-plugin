{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "extras",
  "version": "2026.1105.1",
  "description": "Opt-in Actionfleet skills: write and tighten agent skills, title chats with their Ship, write Conventional Commits.",
  "author": {
    "name": "Actionfleet",
    "url": "https://actionfleet.ai"
  },
  "homepage": "https://actionfleet.ai",
  "repository": "https://github.com/actionfleetai/actionfleet-plugin",
  "license": "MIT",
  "keywords": [
    "skills",
    "commits",
    "conventional-commits",
    "titles"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Actionfleet Extras",
        "shortDescription": "Opt-in skills: skill writing, chat titles, commits",
        "developerName": "Actionfleet",
        "category": "Productivity",
        "websiteURL": "https://actionfleet.ai",
        "privacyPolicyURL": "https://actionfleet.ai/privacy",
        "termsOfServiceURL": "https://actionfleet.ai/terms",
        "defaultPrompt": [
          "Tighten this skill.",
          "Write the commit message for these changes.",
          "Title this chat with its Ship."
        ]
      }
    }
  }
}
