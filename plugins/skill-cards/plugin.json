{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "skill-cards",
  "version": "2026.1103.2",
  "description": "Opt-in Actionfleet skill: write and revise agent skills as short, testable cards.",
  "author": {
    "name": "Actionfleet",
    "url": "https://actionfleet.ai"
  },
  "homepage": "https://actionfleet.ai",
  "repository": "https://github.com/actionfleetai/actionfleet-plugin",
  "license": "MIT",
  "keywords": [
    "skills",
    "runbook",
    "sop"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Skill Cards",
        "shortDescription": "Write skills as short, testable cards",
        "developerName": "Actionfleet",
        "category": "Productivity",
        "websiteURL": "https://actionfleet.ai",
        "privacyPolicyURL": "https://actionfleet.ai/privacy",
        "termsOfServiceURL": "https://actionfleet.ai/terms",
        "defaultPrompt": [
          "Write a skill card for this workflow.",
          "Tighten this skill into a card.",
          "Check my skills against the card format."
        ]
      }
    }
  }
}
